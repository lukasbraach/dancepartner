# Copy to docker/.env and fill in. docker/.env is gitignored: the root .gitignore ignores .env
# at any depth. Nothing in this file is a real value.

DP_DOMAIN=dancepartner.example.org
DP_TLS_EMAIL=coach@example.org

# Placeholder authentication -- see the comment in docker/Caddyfile for where OIDC goes.
DP_BASIC_USER=coach
# Generate with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'the-password'
# Leave it unquoted. It reaches the container through env_file, so the leading $2a$ is safe.
DP_BASIC_HASH=

# en or de. The UI's sidebar toggle overrides this per browser session; this is the default a
# coach lands on.
DANCEPARTNER_LANG=en

# Which published image compose should run when it is not building locally.
DP_TAG=latest
